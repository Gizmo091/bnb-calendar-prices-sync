{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "0.2.0",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.airbnb.fr/*",
    "https://*.airbnb.com/*",
    "https://*.abritel.fr/*",
    "https://*.vrbo.com/*",
    "https://data.education.gouv.fr/*",
    "https://calendrier.api.gouv.fr/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_ext_name__"
  },
  "side_panel": {
    "default_path": "src/ui/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.airbnb.fr/*",
        "https://*.airbnb.com/*",
        "https://*.abritel.fr/*",
        "https://*.vrbo.com/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/adapters/*.js",
        "src/core/*.js"
      ],
      "matches": [
        "https://*.airbnb.fr/*",
        "https://*.airbnb.com/*",
        "https://*.abritel.fr/*",
        "https://*.vrbo.com/*"
      ]
    }
  ]
}
